# Local development defaults to SQLite + in-memory LangGraph checkpoints.
DATABASE_URL=sqlite:///./gtm.db
GRAPH_CHECKPOINT_BACKEND=memory

# For PostgreSQL, use e.g.:
# DATABASE_URL=postgresql+psycopg://gtm:gtm@localhost:5432/gtm
# GRAPH_CHECKPOINT_BACKEND=postgres
# CHECKPOINT_DATABASE_URL=postgresql://gtm:gtm@localhost:5432/gtm

# ICP parameters: adapt these before using scores operationally.
ICP_TARGET_INDUSTRIES=b2b saas,saas,software,technology,tech
ICP_MIN_EMPLOYEES=
ICP_MAX_EMPLOYEES=
ICP_SIGNAL_MAX_AGE_DAYS=180
