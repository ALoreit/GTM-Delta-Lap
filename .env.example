# Local development defaults to SQLite.
DATABASE_URL=sqlite:///./gtm.db

# After loading extension/ in chrome://extensions, set this to its exact origin.
# Example format: chrome-extension://abcdefghijklmnopabcdefghijklmnop
CHROME_EXTENSION_ORIGIN=


# ICP parameters: adapt these before using scores operationally.
ICP_TARGET_INDUSTRIES=b2b saas,saas,software,technology,tech
ICP_MIN_EMPLOYEES=
ICP_MAX_EMPLOYEES=
ICP_SIGNAL_MAX_AGE_DAYS=180
